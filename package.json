{
	"name": "perlink-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"dev:wrangler": "pnpm run build && wrangler pages dev dist --port=3000",
		"preview": "pnpm run build && wrangler pages dev --port=3000",
		"db:migrate": "wrangler d1 migrations apply perlink_to_db --local",
		"db:migrate:remote": "wrangler d1 migrations apply perlink_to_db --remote",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"typecheck": "nuxt typecheck",
		"postbuild": "node scripts/fix-routes.mjs",
		"deploy": "pnpm run build && npx wrangler --cwd dist pages deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@iconify-json/lucide": "^1.2.104",
		"@internationalized/date": "^3.7.0",
		"@iconify-json/simple-icons": "^1.2.80",
		"@iconify/vue": "^5.0.1",
		"@inspira-ui/plugins": "^0.0.2",
		"@nuxt/icon": "2.2.2",
		"@nuxt/ui": "^4.7.1",
		"@svg-maps/world": "^2.0.0",
		"@vueuse/components": "^14.3.0",
		"@vueuse/core": "^14.3.0",
		"animate.css": "^4.1.1",
		"chart.js": "^4.5.1",
		"chartjs-chart-geo": "^4.3.6",
		"chartjs-plugin-datalabels": "^2.2.0",
		"date-fns": "^4.1.0",
		"jose": "^6.2.3",
		"lodash-es": "^4.18.1",
		"motion-v": "^2.3.0",
		"nanoid": "^5.0.0",
		"nuxt": "^4.3.0",
		"nuxt-auth-utils": "0.5.29",
		"ogl": "^1.0.11",
		"qrcode-generator": "^2.0.4",
		"tailwindcss": "^4.3.0",
		"ua-parser-js": "^2.0.10",
		"vue": "^3.5.34",
		"vue-router": "^5.0.7",
		"vuedraggable": "4.1.0",
		"world-atlas": "^2.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nuxt/eslint": "^1.15.2",
		"@types/node": "^25.9.1",
		"eslint": "^10.2.1",
		"nitro-cloudflare-dev": "^0.2.2",
		"typescript": "^6.0.3",
		"vue-tsc": "^3.2.7",
		"wrangler": "^4.93.0"
	},
	"packageManager": "pnpm@10.33.2"
}